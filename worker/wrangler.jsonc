{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifuentes-agents",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the whole site: the agent endpoints and the static files of the repository
  // (see .assetsignore in the root for what is not published).
  "routes": [
    { "pattern": "ifuentes.net/*", "zone_name": "ifuentes.net" },
    // Redirects to the apex.
    { "pattern": "www.ifuentes.net/*", "zone_name": "ifuentes.net" },
    // Serves /.well-known/mta-sts.txt (RFC 8461).
    { "pattern": "mta-sts.ifuentes.net/*", "zone_name": "ifuentes.net" }
  ],
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    // The Worker runs first on every request: it resolves paths like GitHub Pages did (src/site.js)
    // and adds the security headers.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
