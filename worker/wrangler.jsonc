{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifuentes-agents",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // Only these paths run the Worker; everything else is served by GitHub Pages as before.
  "routes": [
    // Trailing * so query strings match too (an exact route ignores /ask?query=…); any other path
    // under these prefixes falls through to GitHub Pages in the fetch handler.
    { "pattern": "ifuentes.net/mcp*", "zone_name": "ifuentes.net" },
    { "pattern": "ifuentes.net/a2a*", "zone_name": "ifuentes.net" },
    { "pattern": "ifuentes.net/api*", "zone_name": "ifuentes.net" },
    { "pattern": "ifuentes.net/ask*", "zone_name": "ifuentes.net" },
    { "pattern": "ifuentes.net/", "zone_name": "ifuentes.net" },
    { "pattern": "ifuentes.net/.well-known/api-catalog", "zone_name": "ifuentes.net" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
